# Copy to .env and fill real values
# cp .env.example .env

# Database
POSTGRES_PASSWORD=YOUR_DB_PASSWORD

# Redis
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# Seq (log viewer) — accessible at /seq/
SEQ_PASSWORD=YOUR_SEQ_ADMIN_PASSWORD
SERVER_IP=YOUR_SERVER_IP

# JWT (generate: openssl rand -base64 32)
Jwt__Key=YOUR_BASE64_JWT_SECRET
Jwt__Issuer=tandur-api
Jwt__Audience=tandur-clients
Jwt__ExpiryMinutes=15
Jwt__RefreshExpiryDays=30
Jwt__AdminRefreshExpiryDays=2
Jwt__ChangePasswordExpiryMinutes=15

# Stripe
STRIPE_SECRET_KEY=sk_test_PUT_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_PUT_SECRET_HERE

# ASP.NET
ASPNETCORE_ENVIRONMENT=Production

# Local dev connection strings (used when running dotnet run outside Docker)
ConnectionStrings__DefaultConnection=Host=YOUR_DB_HOST;Port=5432;Database=YOUR_DB_NAME;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD
ConnectionStrings__Redis=YOUR_REDIS_HOST:6379
